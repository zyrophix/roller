-- hyprroll — add to ~/.config/hypr/hyprland.lua
-- Hyprland 0.55+ Lua config, class = hyprroll

-- hyprroll — fullscreen overlay
hl.window_rule({
  match = { class = "hyprroll" },
  float = true,
  fullscreen = true,
  dim_around = false,
  rounding = 0,
  no_blur = true,
})

hl.bind("SUPER + W", hl.dsp.exec_cmd("hyprroll"))

hl.on("hyprland.start", function()
  hl.exec_cmd("awww-daemon")
end)
